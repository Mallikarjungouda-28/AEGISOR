# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/aegisor?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Internal Background Worker HMAC Secret (optional; falls back to JWT_SECRET if omitted)
INTERNAL_WORKER_SECRET=your_worker_hmac_secret_here

# Google Gemini AI Integration (for vulnerability explanations and remediation advice)
# Leave placeholder or empty if testing without AI
GEMINI_API_KEY=your_gemini_api_key_here

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# File Upload Settings (bytes) - Default: 50MB (52428800 bytes)
UPLOAD_MAX_SIZE=52428800

# Supabase Storage Configuration (for cloud ZIP archive storage)
# Keep private; never expose secret key to frontend code
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_BUCKET=project-archives
